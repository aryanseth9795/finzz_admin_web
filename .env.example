# Base URL of the Finzz admin API.
#
# The code defaults to http://localhost:3000/api/v1/admin when this is unset,
# so an unconfigured checkout points at a LOCAL server rather than production.
# Previously the production URL was hardcoded in src/api/adminApi.ts, which
# meant every local dev session mutated live data.
#
# Vite inlines VITE_* variables into the bundle at build time — never put a
# secret here. A base URL is not one.
VITE_API_BASE=http://localhost:3000/api/v1/admin
